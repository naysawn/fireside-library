---
import Layout from '../../layouts/Layout.astro';
import { getAllFiresides, type Fireside } from '../../lib/firesides';
import { marked } from 'marked';

export function getStaticPaths() {
  const firesides = getAllFiresides();
  return firesides.map((f) => ({
    params: { slug: f.slug },
    props: { fireside: f },
  }));
}

interface Props {
  fireside: Fireside;
}

const { fireside } = Astro.props;

function annotateSectionWordCounts(md: string): string {
  const lines = md.split('\n');
  const sections: { headingIdx: number; contentLines: string[] }[] = [];
  let current: { headingIdx: number; contentLines: string[] } | null = null;

  for (let i = 0; i < lines.length; i++) {
    if (/^## /.test(lines[i])) {
      if (current) sections.push(current);
      current = { headingIdx: i, contentLines: [] };
    } else if (current) {
      current.contentLines.push(lines[i]);
    }
  }
  if (current) sections.push(current);

  for (const s of sections) {
    const text = s.contentLines.join(' ')
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/[#*_`>\[\]()]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
    const words = text ? text.split(' ').length : 0;
    lines[s.headingIdx] += ` <span class="word-count">${words.toLocaleString()} words</span>`;
  }

  return lines.join('\n');
}

/**
 * Turn the inline `[n]` citation markers into subtle superscript links, and tag
 * the trailing endnotes block (a "References"/"Citations" heading plus the list
 * that follows it) so it can be styled as a compact, muted note list. Handles
 * both an h2 (`## Citations`) and h3 (`### References`) heading.
 */
function renderFootnotes(html: string): string {
  // Tolerate trailing markup before </h2|h3> — h2 headings carry an injected
  // word-count <span>, which is dropped when the heading is re-tagged.
  const headingRe = /<(h2|h3)(?:\s[^>]*)?>\s*(References|Citations)\b[\s\S]*?<\/\1>/i;
  const m = html.match(headingRe);
  if (!m || m.index === undefined) return html;

  let body = html.slice(0, m.index);
  let tail = html.slice(m.index);

  // Inline markers: `[3]` (with any leading space) -> gray superscript link.
  body = body.replace(
    /\s*\[(\d{1,3})\]/g,
    (_, n) => `<sup class="fn-ref" id="ref-${n}"><a href="#fn-${n}">${n}</a></sup>`,
  );

  // For block quotes, a marker floating at the end of the quoted text reads as
  // out of place. Pull any markers out of each quote and re-attach them as a
  // small right-aligned reference beneath it (the attribution convention).
  body = body.replace(/<blockquote>([\s\S]*?)<\/blockquote>/g, (whole, inner) => {
    const refs: string[] = [];
    const cleaned = inner.replace(/<sup class="fn-ref"[\s\S]*?<\/sup>/g, (s: string) => {
      refs.push(s);
      return '';
    });
    if (refs.length === 0) return whole;
    return `<blockquote>${cleaned}<cite class="blockquote-ref">${refs.join(' ')}</cite></blockquote>`;
  });

  // Tag the endnotes heading, then the first list after it; give each note an
  // id so the superscript links land on it.
  tail = tail.replace(headingRe, (_, tag, label) => `<${tag} class="endnotes-heading">${label}</${tag}>`);
  tail = tail.replace(/<ol>([\s\S]*?)<\/ol>/, (_, inner) => {
    let n = 0;
    const items = inner.replace(/<li>/g, () => `<li id="fn-${++n}">`);
    return `<ol class="endnotes-list">${items}</ol>`;
  });

  return body + tail;
}

const htmlContent = renderFootnotes(await marked(annotateSectionWordCounts(fireside.content)));

const sourceModified = new Date(fireside.sourceModified).toLocaleString('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'America/New_York',
}) + ' EST';

const phaseColors: Record<string, string> = {
  discovery: 'bg-[#fdeada] text-[#b3460f]',
  investigation: 'bg-[#fbd4b4] text-[#993a0e]',
  consolidation: 'bg-[#f6bd92] text-[#7c2d0c]',
};
---

<Layout title={`${fireside.metadata.title} | Fireside Library`} activeNav="firesides">

<header class="bg-[#f5f5f3] pt-24 pb-5 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <a href="/#firesides" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-accent transition-colors no-underline mb-6">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      All firesides
    </a>
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <p class="text-xs font-bold text-accent tracking-wider mb-2">FIRESIDE {String(fireside.metadata.id).padStart(2, '0')}</p>
        <h1 class="text-2xl md:text-3xl font-black tracking-tight leading-tight text-gray-900">{fireside.metadata.title}</h1>
        <div class="mt-3 flex items-center gap-3">
          <span class:list={["text-[0.6875rem] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full", phaseColors[fireside.metadata.phase] || 'bg-gray-100 text-gray-600']}>
            {fireside.metadata.phase}
          </span>
          {fireside.metadata.status && (
            <span class="text-xs text-gray-400">{fireside.metadata.status}</span>
          )}
        </div>
      </div>
      <div class="flex flex-col items-end gap-1">
        <button onclick="window.print()" class="no-print inline-flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-accent transition-colors cursor-pointer bg-transparent border-0">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4.5 6.75V2.25h9v4.5M4.5 13.5H3a1.5 1.5 0 01-1.5-1.5V9A1.5 1.5 0 013 7.5h12A1.5 1.5 0 0116.5 9v3a1.5 1.5 0 01-1.5 1.5h-1.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><rect x="4.5" y="11.25" width="9" height="4.5" rx="0.75" stroke="currentColor" stroke-width="1.25"/></svg>
          Print
        </button>
        <div class="text-[0.6875rem] text-gray-400 font-mono text-right leading-tight">
          <div>{fireside.sourceFile}</div>
          <div>{sourceModified}</div>
        </div>
      </div>
    </div>
  </div>
</header>

<article class="py-8 md:py-10">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <div class="fireside-prose" set:html={htmlContent} />
  </div>
</article>

</Layout>
