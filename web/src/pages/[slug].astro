---
import Layout from '../layouts/Layout.astro';
import { getAllModules, type Module, type DraftWithGrade, type Grade } from '../lib/modules';
import { marked } from 'marked';

export function getStaticPaths() {
  const modules = getAllModules();
  return modules.map((mod) => ({
    params: { slug: mod.slug },
    props: { module: mod },
  }));
}

interface Props {
  module: Module;
}

const { module } = Astro.props;

function annotateSectionWordCounts(md: string): string {
  const lines = md.split('\n');
  const sections: { headingIdx: number; contentLines: string[] }[] = [];
  let current: { headingIdx: number; contentLines: string[] } | null = null;

  for (let i = 0; i < lines.length; i++) {
    if (/^## /.test(lines[i])) {
      if (current) sections.push(current);
      current = { headingIdx: i, contentLines: [] };
    } else if (current) {
      current.contentLines.push(lines[i]);
    }
  }
  if (current) sections.push(current);

  for (const s of sections) {
    const text = s.contentLines.join(' ')
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/[#*_`>\[\]()]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
    const words = text ? text.split(' ').length : 0;
    lines[s.headingIdx] += ` <span class="word-count">${words.toLocaleString()} words</span>`;
  }

  return lines.join('\n');
}

// Pre-render markdown for every draft
const draftHtmls: Record<string, string> = {};
for (const d of module.drafts) {
  draftHtmls[d.version] = await marked(annotateSectionWordCounts(d.content));
}

const phaseColors: Record<string, string> = {
  discovery: 'bg-gray-200 text-gray-600',
  investigation: 'bg-gray-200 text-gray-700',
  consolidation: 'bg-gray-300 text-gray-800',
};

type GateStatus = 'ship' | 'advance' | 'fail' | 'ungraded';

function gradeStatus(g: Grade | null): GateStatus {
  if (!g) return 'ungraded';
  if (g.ship_gate_passed) return 'ship';
  if (g.advance_gate_passed) return 'advance';
  return 'fail';
}

const gateLabel: Record<GateStatus, string> = {
  ship: 'Ship-ready',
  advance: 'Advance-ready',
  fail: 'Below gate',
  ungraded: 'Not graded',
};

const gateColor: Record<GateStatus, string> = {
  ship: 'bg-emerald-100 text-emerald-800 border-emerald-300',
  advance: 'bg-amber-100 text-amber-800 border-amber-300',
  fail: 'bg-rose-100 text-rose-800 border-rose-300',
  ungraded: 'bg-gray-100 text-gray-600 border-gray-300',
};

function dimColor(score: number, max: number): string {
  const pct = score / max;
  if (pct >= 0.8) return 'bg-emerald-500';
  if (pct >= 0.6) return 'bg-amber-500';
  return 'bg-rose-500';
}

function fmtDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function fmtModified(iso: string): string {
  return new Date(iso).toLocaleString('en-US', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'America/New_York',
  }) + ' EST';
}

function draftLabel(d: DraftWithGrade): string {
  const score = d.grade ? `${d.grade.total}/${d.grade.max}` : 'ungraded';
  return `${d.version} — ${score}`;
}

const newest = module.drafts[0];
---

<Layout title={`${module.metadata.title} | Baha'i Modules`} activeNav="modules">

<header class="bg-[#f5f5f3] pt-24 pb-5 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <a href="/modules" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-accent transition-colors no-underline mb-6">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      All modules
    </a>
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <p class="text-xs font-bold text-accent tracking-wider mb-2">MODULE {String(module.metadata.id).padStart(2, '0')}</p>
        <h1 class="text-2xl md:text-3xl font-black tracking-tight leading-tight text-gray-900">{module.metadata.title}</h1>
        <div class="mt-3 flex items-center gap-3">
          <span class:list={["text-[0.6875rem] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full", phaseColors[module.metadata.phase] || 'bg-gray-100 text-gray-600']}>
            {module.metadata.phase}
          </span>
          {module.metadata.status && (
            <span class="text-xs text-gray-400">{module.metadata.status}</span>
          )}
        </div>
      </div>
      <div class="flex flex-col items-end gap-1">
        <button onclick="window.print()" class="no-print inline-flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-accent transition-colors cursor-pointer bg-transparent border-0">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4.5 6.75V2.25h9v4.5M4.5 13.5H3a1.5 1.5 0 01-1.5-1.5V9A1.5 1.5 0 013 7.5h12A1.5 1.5 0 0116.5 9v3a1.5 1.5 0 01-1.5 1.5h-1.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><rect x="4.5" y="11.25" width="9" height="4.5" rx="0.75" stroke="currentColor" stroke-width="1.25"/></svg>
          Print
        </button>
        {module.drafts.map((d, i) => (
          <div class={`draft-file text-[0.6875rem] text-gray-400 font-mono text-right leading-tight ${i === 0 ? '' : 'hidden'}`} data-draft={d.version}>
            <div>{d.filename}</div>
            <div>{fmtModified(d.modified)}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</header>

<aside class="no-print bg-gray-50 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-6 md:px-12 py-3">
    <details class="group">
      <summary class="list-none cursor-pointer flex items-center gap-3 flex-wrap">
        <span class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-500">Editorial · Grade</span>

        <label class="text-[0.65rem] text-gray-500 sr-only" for="draft-switcher">Draft</label>
        <select id="draft-switcher" class="text-xs font-semibold bg-white border border-gray-300 rounded-md px-2 py-1 cursor-pointer hover:border-gray-400 transition-colors" onclick="event.stopPropagation()">
          {module.drafts.map((d, i) => (
            <option value={d.version} selected={i === 0}>{draftLabel(d)}{i === 0 ? ' (newest)' : ''}</option>
          ))}
        </select>

        {module.drafts.map((d, i) => {
          const g = d.grade;
          const s = gradeStatus(g);
          return (
            <span class={`draft-chips inline-flex items-center gap-3 flex-wrap ${i === 0 ? '' : 'hidden'}`} data-draft={d.version}>
              {g ? (
                <>
                  <span class="text-base font-bold text-gray-900 tabular-nums">{g.total}<span class="text-xs font-semibold text-gray-400">/{g.max}</span></span>
                  <span class={`text-[0.65rem] font-semibold px-2 py-0.5 rounded-full border ${gateColor[s]}`}>{gateLabel[s]}</span>
                  <span class="text-xs text-gray-400">{fmtDate(g.graded_at)}</span>
                  {!g.coverage_gate_passed && (
                    <span class="text-[0.65rem] font-semibold px-2 py-0.5 rounded-full border bg-rose-100 text-rose-800 border-rose-300">Coverage gate failed</span>
                  )}
                  {g.spec_missing && (
                    <span class="text-[0.65rem] font-semibold px-2 py-0.5 rounded-full border bg-amber-100 text-amber-800 border-amber-300">No spec</span>
                  )}
                </>
              ) : (
                <>
                  <span class={`text-[0.65rem] font-semibold px-2 py-0.5 rounded-full border ${gateColor.ungraded}`}>{gateLabel.ungraded}</span>
                  <span class="text-xs text-gray-400">Run <code class="text-[0.7rem] bg-gray-200 px-1 py-0.5 rounded">/grade-module {String(module.metadata.id).padStart(2, '0')}</code> to grade this draft</span>
                </>
              )}
            </span>
          );
        })}

        <svg class="ml-auto w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>

      {module.drafts.map((d, i) => {
        const g = d.grade;
        if (!g) return null;
        return (
          <div class={`draft-details mt-5 pb-3 space-y-6 ${i === 0 ? '' : 'hidden'}`} data-draft={d.version}>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
              {g.dimensions.map((dim) => (
                <div class="flex items-center gap-3">
                  <div class="text-xs text-gray-700 w-44 shrink-0 truncate" title={dim.name}>{dim.name}</div>
                  <div class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div class={`h-full rounded-full ${dimColor(dim.score, dim.max)}`} style={`width: ${(dim.score / dim.max) * 100}%`}></div>
                  </div>
                  <div class="text-xs font-semibold text-gray-700 tabular-nums w-8 text-right">{dim.score}/{dim.max}</div>
                </div>
              ))}
            </div>

            <div class="space-y-4">
              {g.dimensions.map((dim) => dim.sub_items && dim.sub_items.length > 0 && (
                <div class="bg-white border border-gray-200 rounded-lg p-4">
                  <div class="flex items-baseline justify-between mb-2">
                    <h3 class="text-sm font-bold text-gray-900">{dim.name}</h3>
                    <span class="text-xs font-semibold text-gray-500 tabular-nums">{dim.score}/{dim.max}</span>
                  </div>
                  <ul class="space-y-2">
                    {dim.sub_items.map((item) => (
                      <li class="flex gap-2 items-start text-xs">
                        <span class={`mt-0.5 w-4 h-4 rounded-full flex items-center justify-center text-white shrink-0 ${item.passed ? 'bg-emerald-500' : 'bg-rose-400'}`}>
                          {item.passed ? '✓' : '✗'}
                        </span>
                        <div class="flex-1">
                          <div class="text-gray-800">{item.text}</div>
                          {item.evidence && (
                            <div class="text-gray-500 italic mt-1 leading-relaxed border-l-2 border-gray-200 pl-2.5">"{item.evidence}"</div>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            {g.ai_tells_found && g.ai_tells_found.length > 0 && (
              <div class="bg-white border border-gray-200 rounded-lg p-4">
                <h3 class="text-sm font-bold text-gray-900 mb-2">AI tells flagged ({g.ai_tells_found.length})</h3>
                <ul class="text-xs text-gray-700 space-y-1">
                  {g.ai_tells_found.map((tell) => (
                    <li><code class="bg-rose-50 text-rose-800 px-1 py-0.5 rounded text-[0.7rem]">{tell.match}</code> <span class="text-gray-500">— {tell.pattern}{tell.location ? ` (${tell.location})` : ''}</span></li>
                  ))}
                </ul>
              </div>
            )}

            {g.summary_fixes && g.summary_fixes.length > 0 && (
              <div class="bg-white border border-gray-200 rounded-lg p-4">
                <h3 class="text-sm font-bold text-gray-900 mb-2">Top fixes</h3>
                <ul class="text-xs text-gray-700 space-y-1.5 list-disc list-inside">
                  {g.summary_fixes.map((fix) => <li>{fix}</li>)}
                </ul>
              </div>
            )}

            <div class="text-[0.65rem] text-gray-400 font-mono pt-2 border-t border-gray-200">
              grades/{g.filename} · rubric v{g.rubric_version}
            </div>
          </div>
        );
      })}
    </details>
  </div>
</aside>

<article class="py-8 md:py-10">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    {module.drafts.map((d, i) => (
      <div class={`draft-content ${i === 0 ? '' : 'hidden'}`} data-draft={d.version}>
        <div class="module-prose" set:html={draftHtmls[d.version]} />
      </div>
    ))}
  </div>
</article>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const switcher = document.getElementById('draft-switcher');
    if (!switcher) return;
    switcher.addEventListener('change', (e) => {
      const v = e.target.value;
      document.querySelectorAll('[data-draft]').forEach((el) => {
        if (el.dataset.draft === v) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
    });
  });
</script>

</Layout>
