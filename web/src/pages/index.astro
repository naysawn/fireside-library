---
import Layout from '../layouts/Layout.astro';
import { getAllFiresides } from '../lib/firesides';

const firesides = getAllFiresides();
---

<Layout title="Fireside Library" activeNav="home">

<header class="hero-night min-h-[50vh] md:min-h-[68vh] flex items-center pt-28 md:pt-32 pb-16 md:pb-20 text-white">
  <div class="relative max-w-5xl mx-auto px-6 md:px-12 w-full">
    <h1 class="hero-rise text-5xl md:text-7xl font-black tracking-tight leading-[1.02] max-w-3xl">Open-source materials for <em>exploring</em> the Baha'i&nbsp;Faith.</h1>
    <p class="hero-rise text-lg md:text-xl text-white/85 mt-6 max-w-xl leading-relaxed" style="animation-delay:.1s">Plain-language firesides on the Faith's teachings, history, and practices — free to read, and open for anyone to improve.</p>
    <div class="hero-rise flex flex-wrap items-center gap-x-6 gap-y-3 mt-10" style="animation-delay:.2s">
      <a href="#firesides" class="inline-flex items-center gap-2 bg-accent text-white font-semibold text-sm px-6 py-3 rounded-full no-underline shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        Browse the library
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="/contribute" class="text-sm font-medium text-white/90 no-underline transition hover:text-white">Contribute</a>
      <span class="text-[0.8125rem] text-white/60">{firesides.length} firesides</span>
    </div>
  </div>
</header>

<section id="firesides" class="py-12 md:py-16 scroll-mt-16">
  <div class="max-w-5xl mx-auto px-6 md:px-12">

    <!-- View toggle and filters -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <div class="flex flex-wrap gap-2" id="filters">
        <button class="filter-btn active" data-filter="all">All <span class="count"></span></button>
        <button class="filter-btn" data-filter="discovery">Discovery</button>
        <button class="filter-btn" data-filter="investigation">Investigation</button>
        <button class="filter-btn" data-filter="consolidation">Consolidation</button>
      </div>
      <div class="flex gap-2">
        <button class="view-btn active" data-view="list" aria-label="List view">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="1" y="2" width="16" height="2" rx="1" fill="currentColor"/><rect x="1" y="8" width="16" height="2" rx="1" fill="currentColor"/><rect x="1" y="14" width="16" height="2" rx="1" fill="currentColor"/></svg>
        </button>
        <button class="view-btn" data-view="kanban" aria-label="Kanban view">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="1" y="1" width="4" height="16" rx="1" fill="currentColor"/><rect x="7" y="1" width="4" height="10" rx="1" fill="currentColor"/><rect x="13" y="1" width="4" height="13" rx="1" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

    <!-- List view -->
    <div id="list-view">
      <div class="border-t border-gray-200">
        {firesides.map((f) => (
          <a href={`/firesides/${f.slug}`} class="fireside-row group" data-phase={f.metadata.phase}>
            <span class="text-[0.8125rem] font-bold text-accent/50 w-8">{String(f.metadata.id).padStart(2, '0')}</span>
            <span class="font-semibold text-gray-900 group-hover:text-accent transition-colors flex-1">{f.metadata.title}</span>
            <span class:list={["phase-badge", `phase-${f.metadata.phase}`]}>{f.metadata.phase}</span>
            <span class="text-[0.75rem] text-gray-400 hidden md:inline">{f.metadata.status}</span>
            <svg class="w-4 h-4 text-gray-300 group-hover:text-accent group-hover:translate-x-0.5 transition-all" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Kanban view -->
    <div id="kanban-view" class="hidden">
      <div class="grid md:grid-cols-3 gap-6">
        {['discovery', 'investigation', 'consolidation'].map((phase) => (
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-gray-700 mb-4">{phase}</h3>
            <div class="flex flex-col gap-3">
              {firesides.filter(f => f.metadata.phase === phase).map((f) => (
                <a href={`/firesides/${f.slug}`} class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-accent/40 hover:shadow-sm transition group no-underline">
                  <div class="flex items-baseline gap-2">
                    <span class="text-xs font-bold text-accent/60">{String(f.metadata.id).padStart(2, '0')}</span>
                    <span class="text-sm font-semibold text-gray-900 group-hover:text-accent transition-colors">{f.metadata.title}</span>
                  </div>
                  <span class="text-xs text-gray-400 mt-1 inline-block">{f.metadata.status}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

</Layout>

<style>
  .filter-btn {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid #e5e5e5;
    background: white;
    color: #737373;
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-btn:hover { border-color: #a3a3a3; color: #333; }
  .filter-btn.active { background: #111; color: white; border-color: #111; }

  .view-btn {
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid #e5e5e5;
    background: white;
    color: #a3a3a3;
    cursor: pointer;
    transition: all 0.15s;
  }
  .view-btn:hover { color: #333; border-color: #a3a3a3; }
  .view-btn.active { background: #111; color: white; border-color: #111; }

  .fireside-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid #e5e5e5;
    text-decoration: none;
    transition: background 0.1s;
  }
  .fireside-row:hover { background: #fafafa; padding-left: 8px; padding-right: 8px; margin-left: -8px; margin-right: -8px; border-radius: 6px; }

  .phase-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 9999px;
  }
  .phase-discovery { background: #fdeada; color: #b3460f; }
  .phase-investigation { background: #fbd4b4; color: #993a0e; }
  .phase-consolidation { background: #f6bd92; color: #7c2d0c; }
</style>

<script>
  // Filter logic
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.getAttribute('data-filter');
      document.querySelectorAll('.fireside-row').forEach(row => {
        const el = row as HTMLElement;
        if (filter === 'all' || el.dataset.phase === filter) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // View toggle
  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const view = btn.getAttribute('data-view');
      const listView = document.getElementById('list-view')!;
      const kanbanView = document.getElementById('kanban-view')!;
      if (view === 'list') {
        listView.classList.remove('hidden');
        kanbanView.classList.add('hidden');
      } else {
        listView.classList.add('hidden');
        kanbanView.classList.remove('hidden');
      }
    });
  });
</script>
