---
import Layout from '../layouts/Layout.astro';
import { getAllModules } from '../lib/modules';

const modules = getAllModules();

type GateStatus = 'ship' | 'advance' | 'fail' | 'ungraded';

function gateStatus(g: typeof modules[0]['latestGrade']): GateStatus {
  if (!g) return 'ungraded';
  if (g.ship_gate_passed) return 'ship';
  if (g.advance_gate_passed) return 'advance';
  return 'fail';
}

const totals = {
  ship: modules.filter(m => gateStatus(m.latestGrade) === 'ship').length,
  advance: modules.filter(m => gateStatus(m.latestGrade) === 'advance').length,
  fail: modules.filter(m => gateStatus(m.latestGrade) === 'fail').length,
  ungraded: modules.filter(m => gateStatus(m.latestGrade) === 'ungraded').length,
};

const statusLabel: Record<GateStatus, string> = {
  ship: 'Ship-ready',
  advance: 'Advance-ready',
  fail: 'Below gate',
  ungraded: 'Not graded',
};

const statusClass: Record<GateStatus, string> = {
  ship: 'bg-emerald-100 text-emerald-800 border-emerald-200',
  advance: 'bg-amber-100 text-amber-800 border-amber-200',
  fail: 'bg-rose-100 text-rose-800 border-rose-200',
  ungraded: 'bg-gray-100 text-gray-600 border-gray-200',
};

function dimColor(score: number, max: number): string {
  const pct = score / max;
  if (pct >= 0.8) return 'bg-emerald-500';
  if (pct >= 0.6) return 'bg-amber-500';
  return 'bg-rose-500';
}

function fmtDate(iso: string): string {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Grades | Baha'i Modules" activeNav="grades">

<header class="bg-gray-900 pt-32 pb-16 text-white">
  <div class="max-w-6xl mx-auto px-6 md:px-12">
    <p class="text-sm font-semibold text-white/50 uppercase tracking-wider mb-2">Editorial dashboard</p>
    <h1 class="text-3xl md:text-4xl font-black tracking-tight mb-2">Module Grades</h1>
    <p class="text-base text-white/70 max-w-2xl">Most recent rubric score per module, read from each module's <code class="text-xs bg-white/10 px-1.5 py-0.5 rounded">grades/</code> folder. Rubric at <code class="text-xs bg-white/10 px-1.5 py-0.5 rounded">content/brief/rubric.md</code>.</p>
  </div>
</header>

<section class="py-10 md:py-14 bg-gray-50 border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white border border-emerald-200 rounded-xl p-5">
        <div class="text-3xl font-black text-emerald-700">{totals.ship}</div>
        <div class="text-sm font-medium text-emerald-900 mt-1">Ship-ready</div>
        <div class="text-xs text-gray-500 mt-0.5">≥ 36/40 & Coverage ≥ 4</div>
      </div>
      <div class="bg-white border border-amber-200 rounded-xl p-5">
        <div class="text-3xl font-black text-amber-700">{totals.advance}</div>
        <div class="text-sm font-medium text-amber-900 mt-1">Advance-ready</div>
        <div class="text-xs text-gray-500 mt-0.5">32–35/40 & Coverage ≥ 4</div>
      </div>
      <div class="bg-white border border-rose-200 rounded-xl p-5">
        <div class="text-3xl font-black text-rose-700">{totals.fail}</div>
        <div class="text-sm font-medium text-rose-900 mt-1">Below gate</div>
        <div class="text-xs text-gray-500 mt-0.5">Below 32/40 or Coverage failed</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-5">
        <div class="text-3xl font-black text-gray-500">{totals.ungraded}</div>
        <div class="text-sm font-medium text-gray-700 mt-1">Not graded</div>
        <div class="text-xs text-gray-500 mt-0.5">No JSON in <code class="text-[0.7rem]">grades/</code> yet</div>
      </div>
    </div>
  </div>
</section>

<section class="py-10 md:py-14">
  <div class="max-w-6xl mx-auto px-6 md:px-12">
    <div class="flex flex-col gap-4">
      {modules.map((mod) => {
        const status = gateStatus(mod.latestGrade);
        const g = mod.latestGrade;
        return (
          <article class="bg-white border border-gray-200 rounded-xl p-5 md:p-6 hover:shadow-sm transition-shadow">
            <div class="flex flex-wrap items-start gap-3 md:gap-5 justify-between mb-4">
              <div class="flex items-baseline gap-3 flex-1 min-w-0">
                <span class="text-sm font-bold text-gray-300 tabular-nums">{String(mod.metadata.id).padStart(2, '0')}</span>
                <a href={`/${mod.slug}`} class="text-lg md:text-xl font-bold text-gray-900 hover:text-accent transition-colors no-underline truncate">
                  {mod.metadata.title}
                </a>
                <span class="hidden md:inline text-xs text-gray-400 capitalize">{mod.metadata.phase}</span>
                <span class="hidden md:inline text-xs text-gray-400">·</span>
                <span class="hidden md:inline text-xs text-gray-400">{mod.metadata.status}</span>
              </div>
              <div class="flex items-center gap-3">
                {g && (
                  <div class="text-right">
                    <div class="text-2xl font-black text-gray-900 tabular-nums leading-none">{g.total}<span class="text-sm font-semibold text-gray-400">/{g.max}</span></div>
                    <div class="text-[0.7rem] text-gray-500 mt-1">{fmtDate(g.graded_at)} · {g.draft_version}</div>
                  </div>
                )}
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${statusClass[status]}`}>{statusLabel[status]}</span>
              </div>
            </div>

            {g ? (
              <>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 mb-4">
                  {g.dimensions.map((d) => (
                    <div class="flex items-center gap-3">
                      <div class="text-xs text-gray-700 w-44 shrink-0 truncate" title={d.name}>{d.name}</div>
                      <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
                        <div class={`h-full rounded-full ${dimColor(d.score, d.max)}`} style={`width: ${(d.score / d.max) * 100}%`}></div>
                      </div>
                      <div class="text-xs font-semibold text-gray-700 tabular-nums w-8 text-right">{d.score}/{d.max}</div>
                    </div>
                  ))}
                </div>

                {!g.coverage_gate_passed && (
                  <div class="text-xs bg-rose-50 border border-rose-200 text-rose-800 px-3 py-2 rounded-md mb-3">
                    <strong>Coverage gate failed.</strong> Module fails regardless of total — Topical Coverage scored below 4/5.
                  </div>
                )}

                {g.spec_missing && (
                  <div class="text-xs bg-amber-50 border border-amber-200 text-amber-800 px-3 py-2 rounded-md mb-3">
                    <strong>Graded without a spec.</strong> Add a <code>spec:</code> block to <code>metadata.yaml</code> for spec-driven scoring on Coverage, Quotations, and Arc.
                  </div>
                )}

                {g.summary_fixes && g.summary_fixes.length > 0 && (
                  <div class="border-t border-gray-100 pt-3 mt-3">
                    <div class="text-[0.7rem] font-bold uppercase tracking-wider text-gray-500 mb-2">Top fixes</div>
                    <ul class="text-sm text-gray-700 space-y-1 list-disc list-inside">
                      {g.summary_fixes.slice(0, 3).map((fix) => <li>{fix}</li>)}
                    </ul>
                  </div>
                )}
              </>
            ) : (
              <div class="text-sm text-gray-500 italic">
                Not graded yet. Run <code class="not-italic text-gray-700 bg-gray-100 px-1.5 py-0.5 rounded text-xs">/grade-module {String(mod.metadata.id).padStart(2, '0')}</code> to generate a report.
              </div>
            )}
          </article>
        );
      })}
    </div>

    <p class="text-xs text-gray-400 mt-8 text-center">
      Reads the most recent JSON in each module's <code>grades/</code> folder · Rubric v1
    </p>
  </div>
</section>

</Layout>
