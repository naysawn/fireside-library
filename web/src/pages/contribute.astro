---
import Layout from '../layouts/Layout.astro';
import PageCharacter from '../components/PageCharacter.astro';
---

<Layout title="Contribute | Fireside Library" activeNav="contribute">

<header class="bg-accent pt-36 pb-16 text-white">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <h1 class="text-3xl md:text-4xl font-black tracking-tight">Contribute</h1>
  </div>
</header>

<section class="py-16 md:py-20">
  <div class="max-w-5xl mx-auto px-6 md:px-12">

    <!-- How we make them -->
    <h2 class="text-2xl font-extrabold tracking-tight mb-8">How we make them</h2>
    <div class="grid md:grid-cols-3 gap-4 mb-16">
      <div class="relative pl-8 pb-6">
        <div class="absolute left-0 top-0.5 w-5 h-5 rounded-full bg-accent/40 text-white text-[0.625rem] font-bold flex items-center justify-center">1</div>
        <h3 class="font-bold text-sm mb-1">Planning</h3>
        <p class="text-xs text-gray-500 leading-relaxed">A group identifies firesides based on seeker needs. They agree on sections, timeline, and assign a writer and editor.</p>
      </div>
      <div class="relative pl-8 pb-6">
        <div class="absolute left-0 top-0.5 w-5 h-5 rounded-full bg-accent/50 text-white text-[0.625rem] font-bold flex items-center justify-center">2</div>
        <h3 class="font-bold text-sm mb-1">Drafting</h3>
        <p class="text-xs text-gray-500 leading-relaxed">The writer gathers source materials and produces a draft, often with AI assistance.</p>
      </div>
      <div class="relative pl-8 pb-6">
        <div class="absolute left-0 top-0.5 w-5 h-5 rounded-full bg-accent/60 text-white text-[0.625rem] font-bold flex items-center justify-center">3</div>
        <h3 class="font-bold text-sm mb-1">Review</h3>
        <p class="text-xs text-gray-500 leading-relaxed">The editor reviews the arc, sourcing, emphasis, and whether it addresses real questions at the grassroots.</p>
      </div>
      <div class="relative pl-8 pb-6">
        <div class="absolute left-0 top-0.5 w-5 h-5 rounded-full bg-accent/70 text-white text-[0.625rem] font-bold flex items-center justify-center">4</div>
        <h3 class="font-bold text-sm mb-1">Rewrite</h3>
        <p class="text-xs text-gray-500 leading-relaxed">The writer rewrites in their own words. AI may help, but the finished product should read like a human wrote it.</p>
      </div>
      <div class="relative pl-8 pb-6">
        <div class="absolute left-0 top-0.5 w-5 h-5 rounded-full bg-accent/80 text-white text-[0.625rem] font-bold flex items-center justify-center">5</div>
        <h3 class="font-bold text-sm mb-1">Beta</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Published as beta. Feedback is collected each time it is used, at least twice.</p>
      </div>
      <div class="relative pl-8 pb-6">
        <div class="absolute left-0 top-0.5 w-5 h-5 rounded-full bg-accent text-white text-[0.625rem] font-bold flex items-center justify-center">6</div>
        <h3 class="font-bold text-sm mb-1">v1</h3>
        <p class="text-xs text-gray-500 leading-relaxed">The writer incorporates feedback and the fireside is published as v1.</p>
      </div>
    </div>

    <!-- Open source CTA -->
    <div class="bg-gray-900 text-white rounded-2xl p-8 md:p-12 grid md:grid-cols-[1fr_auto] gap-8 items-center">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight mb-4">Open source. Get involved.</h2>
        <p class="text-[0.9375rem] leading-[1.7] text-gray-300 mb-4 max-w-xl">This project started in Boston. We are a small group of Baha'is who wanted better materials for sharing the Faith with seekers. We are still experimenting, still learning, still rewriting.</p>
        <p class="text-[0.9375rem] leading-[1.7] text-gray-300 mb-6 max-w-xl">If you want to try these firesides in your community, adapt them for your context, or help us write new ones, we would be grateful.</p>
        <a href="https://github.com/naysawn/fireside-library" class="inline-flex items-center gap-2 bg-white text-gray-900 font-semibold text-sm px-5 py-2.5 rounded-md no-underline hover:-translate-y-px transition" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          View on GitHub
        </a>
      </div>
      <div class="hidden md:block opacity-20">
        <PageCharacter size="hero" inverted />
      </div>
    </div>

  </div>
</section>

</Layout>
