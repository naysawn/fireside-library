---
// A collection of fanned page characters for the hero section
---

<div class="character-collection">
  <!-- Back page - no face, faint spark -->
  <svg class="page page-back" width="90" height="115" viewBox="0 0 90 115" xmlns="http://www.w3.org/2000/svg">
    <rect x="6" y="4" width="72" height="95" rx="6" fill="rgba(255,255,255,0.7)" stroke="rgba(255,255,255,0.4)" stroke-width="1.3"/>
    <path d="M60 4 L78 22 L60 22 Z" fill="rgba(255,255,255,0.5)" stroke="rgba(255,255,255,0.3)" stroke-width="1" stroke-linejoin="round"/>
    <rect x="16" y="50" width="30" height="3" rx="1.5" fill="rgba(255,255,255,0.2)"/>
    <rect x="16" y="58" width="45" height="3" rx="1.5" fill="rgba(255,255,255,0.15)"/>
    <path d="M45 20 L47 14 L49 20 L55 22 L49 24 L47 30 L45 24 L39 22 Z" fill="rgba(255,255,255,0.35)"/>
  </svg>

  <!-- Second page -->
  <svg class="page page-second" width="90" height="115" viewBox="0 0 90 115" xmlns="http://www.w3.org/2000/svg">
    <rect x="6" y="4" width="72" height="95" rx="6" fill="rgba(255,255,255,0.8)" stroke="rgba(255,255,255,0.45)" stroke-width="1.3"/>
    <path d="M60 4 L78 22 L60 22 Z" fill="rgba(255,255,255,0.6)" stroke="rgba(255,255,255,0.35)" stroke-width="1" stroke-linejoin="round"/>
    <ellipse cx="33" cy="48" rx="3.5" ry="4" fill="rgba(184,53,16,0.7)"/>
    <ellipse cx="53" cy="48" rx="3.5" ry="4" fill="rgba(184,53,16,0.7)"/>
    <path d="M37 56 Q43 62 49 56" stroke="rgba(184,53,16,0.7)" stroke-width="1.8" stroke-linecap="round" fill="none"/>
    <rect x="16" y="68" width="30" height="3" rx="1.5" fill="rgba(255,255,255,0.2)"/>
    <rect x="16" y="76" width="45" height="3" rx="1.5" fill="rgba(255,255,255,0.15)"/>
    <path d="M45 16 L47 10 L49 16 L55 18 L49 20 L47 26 L45 20 L39 18 Z" fill="rgba(255,255,255,0.5)"/>
  </svg>

  <!-- Third page -->
  <svg class="page page-third" width="90" height="115" viewBox="0 0 90 115" xmlns="http://www.w3.org/2000/svg">
    <rect x="6" y="4" width="72" height="95" rx="6" fill="rgba(255,255,255,0.9)" stroke="rgba(255,255,255,0.5)" stroke-width="1.3"/>
    <path d="M60 4 L78 22 L60 22 Z" fill="rgba(255,255,255,0.7)" stroke="rgba(255,255,255,0.4)" stroke-width="1" stroke-linejoin="round"/>
    <ellipse cx="33" cy="48" rx="3.5" ry="4" fill="#b83510"/>
    <ellipse cx="53" cy="48" rx="3.5" ry="4" fill="#b83510"/>
    <path d="M37 56 Q43 62 49 56" stroke="#b83510" stroke-width="1.8" stroke-linecap="round" fill="none"/>
    <rect x="16" y="68" width="30" height="3" rx="1.5" fill="rgba(255,255,255,0.25)"/>
    <rect x="16" y="76" width="45" height="3" rx="1.5" fill="rgba(255,255,255,0.2)"/>
    <g class="spark-pulse">
      <path d="M45 14 L47.5 6 L50 14 L58 17 L50 20 L47.5 28 L45 20 L37 17 Z" fill="rgba(255,255,255,0.8)"/>
    </g>
  </svg>

  <!-- Front page - full detail -->
  <svg class="page page-front" width="90" height="115" viewBox="0 0 90 115" xmlns="http://www.w3.org/2000/svg">
    <rect x="6" y="4" width="72" height="95" rx="6" fill="rgba(255,255,255,0.95)" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
    <path d="M60 4 L78 22 L60 22 Z" fill="rgba(255,255,255,0.8)" stroke="rgba(255,255,255,0.5)" stroke-width="1.2" stroke-linejoin="round"/>
    <g class="eye-blink">
      <ellipse cx="33" cy="48" rx="4" ry="4.5" fill="#b83510"/>
      <ellipse cx="32" cy="46" rx="1.3" ry="1.3" fill="rgba(255,255,255,0.8)"/>
    </g>
    <g class="eye-blink-delayed">
      <ellipse cx="53" cy="48" rx="4" ry="4.5" fill="#b83510"/>
      <ellipse cx="52" cy="46" rx="1.3" ry="1.3" fill="rgba(255,255,255,0.8)"/>
    </g>
    <path d="M37 57 Q43 64 49 57" stroke="#b83510" stroke-width="2" stroke-linecap="round" fill="none"/>
    <ellipse cx="28" cy="55" rx="3.5" ry="1.8" fill="rgba(255,255,255,0.2)"/>
    <ellipse cx="58" cy="55" rx="3.5" ry="1.8" fill="rgba(255,255,255,0.2)"/>
    <rect x="16" y="70" width="30" height="3" rx="1.5" fill="rgba(255,255,255,0.3)"/>
    <rect x="16" y="78" width="45" height="3" rx="1.5" fill="rgba(255,255,255,0.25)"/>
    <rect x="16" y="86" width="20" height="3" rx="1.5" fill="rgba(255,255,255,0.2)"/>
    <g class="spark-twinkle">
      <path d="M43 14 L46 5 L49 14 L58 17 L49 20 L46 29 L43 20 L34 17 Z" fill="#fff"/>
      <path d="M44.5 14.5 L46 9 L47.5 14.5 L53 16.5 L47.5 18.5 L46 24 L44.5 18.5 L39 16.5 Z" fill="rgba(255,255,255,0.5)"/>
    </g>
  </svg>
</div>

<style>
  .character-collection {
    position: relative;
    width: 260px;
    height: 180px;
  }

  .page {
    position: absolute;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.1));
  }

  .page-back {
    left: 0;
    top: 30px;
    transform: rotate(-8deg);
    opacity: 0.5;
  }

  .page-second {
    left: 45px;
    top: 18px;
    transform: rotate(-2deg);
    opacity: 0.7;
  }

  .page-third {
    left: 90px;
    top: 8px;
    transform: rotate(3deg);
    opacity: 0.85;
  }

  .page-front {
    left: 135px;
    top: 0;
    transform: rotate(6deg);
  }

  @keyframes sparkPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }
  @keyframes sparkTwinkle {
    0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }
    25% { opacity: 0.7; transform: scale(0.9) rotate(8deg); }
    50% { opacity: 0.5; transform: scale(0.8) rotate(0deg); }
    75% { opacity: 0.8; transform: scale(0.95) rotate(-5deg); }
  }
  @keyframes eyeBlink {
    0%, 92%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }

  .spark-pulse { animation: sparkPulse 2.4s ease-in-out infinite; transform-origin: center; }
  .spark-twinkle { animation: sparkTwinkle 3s ease-in-out infinite; transform-origin: center; }
  .eye-blink { animation: eyeBlink 4s ease-in-out infinite; transform-origin: center; }
  .eye-blink-delayed { animation: eyeBlink 4s ease-in-out infinite 0.1s; transform-origin: center; }
</style>
