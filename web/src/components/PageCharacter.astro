---
interface Props {
  size?: 'nav' | 'inline' | 'hero';
  inverted?: boolean;
}

const { size = 'nav', inverted = false } = Astro.props;

const sizes = {
  nav: { width: 28, height: 33 },
  inline: { width: 48, height: 56 },
  hero: { width: 90, height: 115 },
};

const { width, height } = sizes[size];

const pageColor = inverted ? 'rgba(255,255,255,0.95)' : '#f8f8f8';
const pageBorder = inverted ? 'rgba(255,255,255,0.5)' : '#c0c0c0';
const earColor = inverted ? 'rgba(255,255,255,0.7)' : '#eeeeee';
const eyeColor = inverted ? '#b83510' : '#333';
const smileColor = inverted ? '#b83510' : '#333';
const sparkColor = inverted ? '#fff' : '#e04e1a';
const textLineColor = inverted ? 'rgba(224,78,26,0.15)' : '#ddd';
const textLine2Color = inverted ? 'rgba(224,78,26,0.1)' : '#e2e2e2';
---

<svg width={width} height={height} viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="6" y="4" width="32" height="42" rx="4" fill={pageColor} stroke={pageBorder} stroke-width="1.3"/>
  <path d="M30 4 L38 12 L30 12 Z" fill={earColor} stroke={pageBorder} stroke-width="1" stroke-linejoin="round"/>
  <ellipse cx="17" cy="24" rx="2" ry="2.2" fill={eyeColor} class="eye-blink"/>
  <ellipse cx="27" cy="24" rx="2" ry="2.2" fill={eyeColor} class="eye-blink-delayed"/>
  <path d="M19 29 Q22 33 25 29" stroke={smileColor} stroke-width="1.3" stroke-linecap="round" fill="none"/>
  {size !== 'nav' && (
    <>
      <rect x="11" y="35" width="14" height="1.5" rx="0.75" fill={textLineColor}/>
      <rect x="11" y="39" width="20" height="1.5" rx="0.75" fill={textLine2Color}/>
    </>
  )}
  <g class="spark-pulse">
    <path d="M22 9 L23.5 5 L25 9 L29 10.5 L25 12 L23.5 16 L22 12 L18 10.5 Z" fill={sparkColor}/>
  </g>
</svg>

<style>
  @keyframes sparkPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }
  @keyframes eyeBlink {
    0%, 92%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  .spark-pulse {
    animation: sparkPulse 2.4s ease-in-out infinite;
    transform-origin: center;
  }
  .eye-blink {
    animation: eyeBlink 4s ease-in-out infinite;
    transform-origin: center;
  }
  .eye-blink-delayed {
    animation: eyeBlink 4s ease-in-out infinite 0.1s;
    transform-origin: center;
  }
</style>
